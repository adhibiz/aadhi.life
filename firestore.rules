rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reads for all content
    match /site_meta/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /projects/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /blog_posts/{doc} { allow read: if resource.data.published == true; allow write: if request.auth != null; }
    match /skills/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /timeline/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /now_page/{doc} { allow read: if true; allow write: if request.auth != null; }
    
    // Guestbook: anyone can add (pending), only admin can approve/delete
    match /guestbook/{doc} {
      allow read: if resource.data.approved == true;
      allow create: if request.resource.data.approved == false 
                    && request.resource.data.name is string 
                    && request.resource.data.message is string;
      allow update, delete: if request.auth != null;
    }
  }
}
