rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public reads for all content
    match /site_meta/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /blog_posts/{doc} { allow read: if resource.data.published == true; allow write: if isAdmin(); }
    match /skills/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /timeline/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /now_page/{doc} { allow read: if true; allow write: if isAdmin(); }
    
    // Guestbook: anyone can add (pending), only admin can approve/delete
    match /guestbook/{doc} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if request.resource.data.approved == false 
                    && request.resource.data.name is string 
                    && request.resource.data.message is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000;
      allow update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
